    "blade_of_the_heptaseas": {
      "name": "Blade of the Heptaseas",
      "option": "\n<#ff7a3eff>Ambush<>: After <#e8a800ff>5s<> without dealing or taking hero damage, the next basic attack deals <#e8a800ff>56<> + <#e8a800ff>40%<> Attack bonus <#d94c49ff>physical damage<> and slows by <#e8a800ff>40%<> for <#e8a800ff>1.5s<>.\n<#e8a800ff>+10<> <#d94c49ff>Physical Penetration<>."
